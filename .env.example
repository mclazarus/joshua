# Local development. Copy to .env (gitignored).
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_CHANNEL_ID=C0123456789
JOSHUA_ADMINS=U0123456789
# uv run joshua genkey
JOSHUA_SECRET_KEY=
DB_PATH=./data/joshua.db
DEFAULT_TZ=America/New_York
DEFAULT_LOUD_HOURS=08:00-22:00
# Hours become minutes, for testing in a sandbox channel.
JOSHUA_FAST_REMINDERS=false
# INFO is plenty; DEBUG adds Slack/HTTP internals.
LOG_LEVEL=INFO
